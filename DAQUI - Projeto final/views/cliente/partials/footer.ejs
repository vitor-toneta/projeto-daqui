<footer class="footer ">

  <script>
    document.addEventListener('DOMContentLoaded', () => {
        const btnAbrir = document.getElementById('btnCategorias');
        const popup = document.getElementById('popupCategorias');
        const btnFechar = document.getElementById('btnFecharCategorias');

        // Abre e fecha ao clicar no título
        btnAbrir.addEventListener('click', (e) => {
            e.stopPropagation();
            const isAberto = popup.classList.contains('ativo');
            
            if (isAberto) {
                popup.classList.remove('ativo');
                setTimeout(() => popup.hidden = true, 200);
            } else {
                popup.hidden = false;
                // Pequeno delay para a transição do CSS funcionar
                setTimeout(() => popup.classList.add('ativo'), 10);
            }
        });

        // Fecha ao clicar no X
        btnFechar.addEventListener('click', () => {
            popup.classList.remove('ativo');
            setTimeout(() => popup.hidden = true, 200);
        });

        // Fecha ao clicar em qualquer lugar fora do menu
        document.addEventListener('click', (e) => {
            if (!popup.contains(e.target) && !btnAbrir.contains(e.target)) {
                popup.classList.remove('ativo');
                setTimeout(() => popup.hidden = true, 200);
            }
        });
    });
    </script>
