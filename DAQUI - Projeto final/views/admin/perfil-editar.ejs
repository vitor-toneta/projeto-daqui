<div class="gradiente">
    <%- include('partials/header', { categorias }) %>
    <%- include('partials/menu') %>

    <main class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">

                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-primary text-white py-3">
                        <h4 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Editar Perfil</h4>
                    </div>

                    <div class="card-body p-4">

                        <form action="/admin/perfil/editar" method="POST" enctype="multipart/form-data">
                            
                            <div class="mb-3">
                                <label class="form-label">Nome da Empresa</label>
                                <input type="text" name="nome_empresa" class="form-control" value="<%= vendedor.nome_empresa %>" required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Nome do Responsável</label>
                                <input type="text" name="nome_responsavel" class="form-control" value="<%= vendedor.nome_responsavel %>" required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">E-mail</label>
                                <input type="email" name="email" class="form-control" value="<%= vendedor.email %>" required>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">CPF (Não editável)</label>
                                    <input type="text" name="cpf" class="form-control bg-light" value="<%= vendedor.cpf %>" readonly>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Telefone</label>
                                    <input type="text" name="telefone" class="form-control" value="<%= vendedor.telefone || '' %>" required>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Endereço</label>
                                <input type="text" name="endereco" class="form-control" value="<%= vendedor.endereco || '' %>" required>
                            </div>

                            <div class="mb-4">
                                <label class="form-label">Cidade</label>
                                <input type="text" name="cidade" class="form-control" value="<%= vendedor.cidade || '' %>" required>
                            </div>

                            <div class="mb-4">
                                <label class="form-label d-block">Foto de Perfil (Deixe em branco para manter a atual)</label>

                                <% if (vendedor.foto) { %>
                                    <img src="/uploads/<%= vendedor.foto %>" class="rounded mb-2" style="width: 80px; height: 80px; object-fit: cover;">
                                <% } %>

                                <input type="file" name="foto" class="form-control" accept="image/*">
                            </div>
                            
                            <hr>
                            
                            <div class="d-flex justify-content-between mt-4">
                                <a href="/admin/perfil" class="btn btn-outline-secondary">Cancelar</a>
                                <button type="submit" class="btn btn-success">
                                    <i class="bi bi-check-circle"></i> Salvar Alterações
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
</div>