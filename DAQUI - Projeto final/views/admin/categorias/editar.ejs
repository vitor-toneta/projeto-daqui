<%- include('../partials/header') %> <%- include('../partials/menu') %>

        <main class="container py-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"> <i class="bi bi-tags"></i> Editar Categoria </h4>
                </div>

                <div class="card-body">
                    <form action="/admin/categorias/editar/<%= categoria.id %>" method="POST"
                        enctype="multipart/form-data">

                        <div class="mb-3"> <label class="form-label">Nome</label> <input type="text" name="nome"
                                class="form-control" value="<%= categoria.nome %>" required> </div>

                        <div class="mb-3"> <label class="form-label">Descrição</label> <textarea name="descricao"
                                class="form-control" rows="4"><%= categoria.descricao %></textarea> </div>

                        <button type="submit" class="btn btn-primary"> <i class="bi bi-check-circle"></i> Salvar
                            alterações </button>

                        <a href="/admin/categorias" class="btn btn-secondary"> Cancelar </a>
                    </form>
                </div>
            </div>
        </main>

        <%- include('../partials/footer') %>